# ==============================================================================
# NirmaanAI Environment Configuration Template (.env.example)
# DO NOT COMMIT ACTUAL PASSWORDS, KEYS, OR SECRETS TO REPOSITORY
# Copy this file to .env and configure your local environment settings.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Persistence Layer (Phase 17)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Example: postgresql+psycopg://nirmaan_admin:your_secure_password@localhost:5432/nirmaanai
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nirmaanai

# Database Engine Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
