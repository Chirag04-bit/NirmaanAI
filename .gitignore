# ==============================================================================
# NirmaanAI .gitignore
# ==============================================================================

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
*.egg

# Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Secrets & Environment Variables
.env
.env.local
.env.*.local
*.pem
*.key

# ------------------------------------------------------------------------------
# Data & Datasets
# ------------------------------------------------------------------------------
# Ignore bulk data payloads in raw, processed, and synthetic directories
DATASET/**/raw/*
DATASET/**/processed/*
DATASET/**/features/*
data/raw/*
data/processed/*
data/synthetic/*
data/external/*

# Ignore bulk tabular, binary, and compressed data files globally
*.zip
*.tar.gz
*.tgz
*.7z
*.rar
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz

# Whitelist dataset documentation, manifests, schemas, metadata, and .gitkeep
!DATASET/**/.gitkeep
!data/**/.gitkeep
!DATASET/**/metadata/
!DATASET/**/metadata/*
!DATASET/**/documentation/
!DATASET/**/documentation/*
!DATASET/**/*.md
!DATASET/**/*.json
!DATASET/**/*.yaml
!DATASET/**/*.yml
!DATASET/**/LICENSE*
!DATASET/**/README*

# ------------------------------------------------------------------------------
# Model Artifacts & Checkpoints
# ------------------------------------------------------------------------------
models/**/*.pkl
models/**/*.joblib
models/**/*.pt
models/**/*.pth
models/**/*.onnx
models/**/*.bin
models/**/*.safetensors
models/*.pkl
models/*.joblib
models/*.pt
models/*.pth
models/*.onnx
models/*.bin
models/*.safetensors
!models/**/.gitkeep
!models/**/*.json
!models/**/*.yaml
!models/**/*.md

# ------------------------------------------------------------------------------
# Vector DB & Embeddings
# ------------------------------------------------------------------------------
rag/vector_db/*
rag/embeddings/*
!rag/vector_db/.gitkeep
!rag/embeddings/.gitkeep
!rag/documents/.gitkeep

# ------------------------------------------------------------------------------
# Logs & Experiment Runs
# ------------------------------------------------------------------------------
logs/*.log
logs/*.jsonl
experiments/runs/*
!logs/.gitkeep
!experiments/.gitkeep

# ------------------------------------------------------------------------------
# Frontend & Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.next/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*

# ------------------------------------------------------------------------------
# IDE & Operating System
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
